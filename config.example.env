# example config - install.sh writes the real one to ~/.config/brain-kit/config.env
# never commit a filled-in copy; this file holds no secrets and no real paths.

# absolute path to your obsidian vault (the brain). ~ is expanded.
BRAIN_VAULT="$HOME/path/to/your-vault"

# absolute path to the claude binary (find yours with: command -v claude)
BRAIN_CLAUDE_BIN="$HOME/.local/bin/claude"

# session name shown in the claude mobile app / claude.ai/code for remote control
BRAIN_LABEL="brain"

# nightly sync time, local clock (24h)
BRAIN_SYNC_HOUR=3
BRAIN_SYNC_MINUTE=0

# set to 0 to skip capturing local claude code / remote-control sessions
BRAIN_CAPTURE_CODE_SESSIONS=1

# optional: get a telegram message when the nightly sync fails (leave blank to disable).
# create a bot with @BotFather, then message it once and read your chat id from
# https://api.telegram.org/bot<token>/getUpdates. keep this file chmod 600.
BRAIN_TELEGRAM_TOKEN=""
BRAIN_TELEGRAM_CHAT_ID=""
