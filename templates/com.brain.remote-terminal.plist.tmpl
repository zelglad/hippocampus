<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- visible-terminal remote control: opens a Terminal window so you watch requests live.
     self-heals via the 30s watchdog. requires GUI login + Terminal automation permission. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brain.remote-terminal</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/.local/share/brain-kit/brain-remote-terminal.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.config/brain-kit/remote-terminal.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.config/brain-kit/remote-terminal.log</string>
</dict>
</plist>
