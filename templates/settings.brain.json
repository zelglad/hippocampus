{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/brain-kit/**)",
      "Read(//**/.env)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/credentials)",
      "Read(//**/session.key)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.gnupg", "~/.config/brain-kit"]
    },
    "excludedCommands": ["launchctl *", "pgrep *", "ps *"]
  }
}
